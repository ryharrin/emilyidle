{
  "name": "watch-idle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "PLAYWRIGHT_E2E_PROFILE=local-fast playwright test",
    "test:e2e:fast": "PLAYWRIGHT_E2E_PROFILE=local-fast playwright test",
    "test:e2e:fast:chromium": "PLAYWRIGHT_E2E_PROFILE=local-fast playwright test --project=chromium",
    "test:e2e:fast:webkit-mobile": "PLAYWRIGHT_E2E_PROFILE=local-fast playwright test --project=webkit-mobile-iphone15",
    "test:e2e:fast:parallel": "PLAYWRIGHT_E2E_PROFILE=local-fast PLAYWRIGHT_FAST_WORKERS=75% playwright test --project=chromium --project=webkit-mobile-iphone15",
    "test:e2e:workspace": "PLAYWRIGHT_WEB_SERVER_PORT=4177 PLAYWRIGHT_REUSE_EXISTING_SERVER=false playwright test",
    "test:e2e:workspace:catalog-readiness": "PLAYWRIGHT_WEB_SERVER_PORT=4177 PLAYWRIGHT_REUSE_EXISTING_SERVER=false playwright test tests/selectors-contract.spec.ts --project=chromium",
    "test:e2e:stable-projects": "PLAYWRIGHT_E2E_PROFILE=stable playwright test --project=chromium --project=webkit-mobile-iphone15",
    "test:e2e:manual": "PLAYWRIGHT_E2E_PROFILE=stable PLAYWRIGHT_INCLUDE_MANUAL=true playwright test -g @manual",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:iphone": "playwright test --project=webkit-mobile-iphone15",
    "test:e2e:webkit-mobile": "playwright test --project=webkit-mobile-iphone15",
    "test:ci:stable": "pnpm test:unit && pnpm test:e2e:stable-projects && pnpm typecheck"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.18",
    "lucide-react": "0.563.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.0.0",
    "vitest": "^1.6.0"
  },
  "vitest": {
    "test": {
      "environment": "jsdom",
      "setupFiles": "./tests/vitest.setup.ts",
      "include": [
        "tests/**/*.unit.test.{ts,tsx}"
      ],
      "exclude": [
        "tests/**/*.spec.{ts,tsx}"
      ]
    }
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
